{
  "manifest_version": 3,
  "name": "JobPilot: send this job",
  "version": "1.0.0",
  "description": "One click sends the job page you are on to your local JobPilot dashboard.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Send this job to JobPilot",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "permissions": ["activeTab", "storage", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:4100/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:4100/api/v1/capture/pair*"],
      "js": ["pair.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+J" },
      "description": "Send this job to JobPilot"
    }
  }
}
