# Copy to .env (gitignored). Read by docker compose and by host-side tooling (backend tests, scripts).
# Absolute path of this repository: bind-mounted at the same path inside the containers.
JOBPILOT_HOME=/Users/you/jobsClaude
JOBPILOT_VAULT=/Users/you/jobsClaude/data/vault

# PostgreSQL (compose service `postgres`, published on host loopback only; containers use postgres:5432)
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=jobpilot
PGUSER=jobpilot
PGPASSWORD=change-me

# Redis broker (compose service `redis`, loopback only, broker only, no persistence)
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=change-me

# Backend (published on 127.0.0.1 only)
BACKEND_PORT=4100
# The per-start API token is generated at runtime; never commit one.

# Agent: BrowserOS neo is the only browser; the browsing agent runs claude-haiku-5-5 only (ADR 0019).
AGENT_MODEL_BROWSER=claude-haiku-5-5
AGENT_MODEL_CV=claude-haiku-5-5
AGENT_EFFORT=medium
# BrowserOS neo's MCP port on the host (one variable). Host-side tooling uses http://127.0.0.1:<port>/mcp via NEO_MCP_URL;
# containers reach it through a loopback relay (docker/entrypoint.sh) that compose.yaml derives from NEO_PORT.
NEO_PORT=9010
NEO_MCP_URL=http://127.0.0.1:9010/mcp
# `claude setup-token` prints a long-lived token. The Claude CLI cannot use the macOS keychain login inside a
# container; keep the token only here (this file is gitignored), never in the repo, compose.yaml or logs.
# CLAUDE_CODE_OAUTH_TOKEN=
# uid/gid of the host user so files written into the bind mount belong to you (`id -u`, `id -g`).
# JP_UID=501
# JP_GID=20

# Celery execution (docs/adr/0012-celery-redis-execution.md)
JOBPILOT_NODE=mac
JOBPILOT_POOL=prefork
# Parallel agents per worker container: the Celery pool size AND (as the default of the Settings stepper) the admission
# cap, which is clamped to the slots the workers really report. Scale out: `docker compose up -d --scale worker=2`.
WORKER_CONCURRENCY=4
MAX_OPEN_BROWSERS=8

# Defaults; the dashboard Settings API persists overrides in PostgreSQL.
# Zero means no per-run limit.
BROWSER_BUDGET_USD=0
BROWSER_RUN_TIMEOUT_SECONDS=0
# No stdout activity for this many seconds means hung; zero disables the watchdog.
AGENT_STALL_SECONDS=900
DOMAIN_GAP_SECONDS=5.0

# Backup service (ADR 0022): bundles go to data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
