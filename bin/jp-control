#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if [ -f "$ROOT/.env" ]; then set -a; . "$ROOT/.env"; set +a; fi
export JOBPILOT_HOME="${JOBPILOT_HOME:-$ROOT}"
export PATH="$ROOT/bin:$PATH"
export JOBPILOT_WORKER_ROLE=control
export JOBPILOT_NODE="${JOBPILOT_NODE:-mac}"
NODE="$JOBPILOT_NODE"
exec "$ROOT/backend/.venv/bin/celery" -A jobpilot.worker.app worker \
  -Q control -P threads -c 4 -n "control-$NODE@%h" \
  --without-gossip --without-mingle --without-heartbeat -l INFO "$@"
